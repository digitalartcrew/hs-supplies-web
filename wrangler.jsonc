{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hardhitta-supplies-web",
  "main": "src/index.ts",
  // Pinned to the newest date the installed workerd binary supports. Bump this
  // only together with a wrangler/miniflare upgrade, then re-run the tests —
  // a date newer than the local runtime breaks `wrangler dev` and vitest.
  "compatibility_date": "2026-08-22",

  // Static site is served straight from the assets store. The Worker script
  // only executes for the Sweed menu prefix, so normal page views cost no
  // Worker invocations.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/menu", "/menu/*"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "vars": {
    "SWEED_UPSTREAM": "https://web-ui-prime.sweedpos.com",
    "PUBLIC_HOST": "hardhitta.supplies"
  },

  // Custom Domains rather than routes: this Worker serves the whole site, so
  // there is no hostname to split. Cloudflare creates and manages the DNS
  // records itself, which avoids a hand-maintained placeholder A record that
  // can be deleted and strand the apex on error 1016.
  //
  // Uncomment together with flipping workers_dev to false, then redeploy.
  // The zone must be in the same Cloudflare account you are logged into.
  //
  "routes": [
    { "pattern": "hardhitta.supplies", "custom_domain": true },
    { "pattern": "www.hardhitta.supplies", "custom_domain": true }
  ],

  // true  → preview only at *.workers.dev, live domain untouched
  // false → go live (set this when uncommenting routes above)
  "workers_dev": false
}
